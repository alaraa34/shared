; Réglages de l'agent de génération des pistes
; Copier ce fichier en agent_pistes.ini (même dossier) et le compléter.
; agent_pistes.ini contient la clé secrète : ne jamais le versionner ni l'envoyer par FTP.

[agent]
; --- un seul site : url_projet et cle ici ---
; adresse du projet, avec la barre finale (test local : http://localhost/theBand/)
url_projet = https://www.kontouma.fr/theBand/
; clé secrète : la même que la première ligne de ENVIRagent.txt du projet visé
cle = A_REMPLACER_PAR_LA_CLE_DU_FICHIER_ENVIRagent

; --- plusieurs sites : supprimer url_projet et cle ci-dessus et décommenter une section par site ---
; [site theBand]
; url_projet = https://www.kontouma.fr/theBand/
; cle = A_REMPLACER_PAR_LA_CLE_DE_theBand/ENVIRagent.txt
; [site training]
; url_projet = https://www.kontouma.fr/training/
; cle = A_REMPLACER_PAR_LA_CLE_DE_training/ENVIRagent.txt
; (les réglages suivants restent dans [agent] : placer les sections [site ...] à la fin du fichier)

; nom du PC affiché sur le site (vide = nom Windows du PC)
nom_agent =

; modèle Demucs : htdemucs_6s sépare voix, batterie, basse, guitare, piano, autre
modele = htdemucs_6s

; débit des MP3 produits (128 suffit pour travailler et reste sous la limite d'envoi de LWS)
mp3_bitrate = 128

; délai entre deux demandes quand il n'y a rien à faire
attente_secondes = 30

; dossier de travail temporaire (vidé après chaque fichier)
dossier_travail = C:\multipistes\travail

; ffmpeg utilisé pour transposer les pistes (vide = celui du PATH)
ffmpeg =

; options supplémentaires passées à Demucs, par exemple "-d cuda" avec une carte NVIDIA
options_demucs =
